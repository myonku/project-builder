# 集成测试依赖的环境变量。与 docker/compose.test.yml 的默认值一致。
# 如需改动端口，请同时更新 Makefile 中的 TEST_* 变量与 internal/testsupport/harness.go 的默认值。

POSTGRES_DB=project_builder_test
POSTGRES_USER=project_builder_test
POSTGRES_PASSWORD=project_builder_test_password
POSTGRES_PORT=15432

REDIS_PASSWORD=project_builder_test_redis_password
REDIS_PORT=16379

MAIL_SMTP_PORT=11025
MAIL_WEB_PORT=18025
