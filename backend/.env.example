# 本地/测试覆盖配置。复制为 .env 使用；进程环境变量优先级最高。
# 本文件只包含字段名与占位符，不得写入真实密码或密钥。

APP_ENV=development
APP_CONFIG_FILE=config.toml

SERVER_HOST=127.0.0.1
SERVER_PORT=8000
SERVER_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=project_builder
DATABASE_USER=project_builder
DATABASE_PASSWORD=change-me
DATABASE_SSL_MODE=disable

REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# MongoDB 7 只存附件/头像字节（GridFS）；local 模式下不会连接。
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DATABASE=worklane
MONGO_CONNECT_TIMEOUT_SECONDS=10
MONGO_SERVER_SELECTION_TIMEOUT_SECONDS=5
MONGO_MAX_POOL_SIZE=20

STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./data/uploads
STORAGE_GRIDFS_BUCKET=attachments
STORAGE_AVATAR_BUCKET=avatars
STORAGE_AVATAR_MAX_FILE_SIZE=2097152

SECURITY_SESSION_SECRET=change-me-in-dev
SECURITY_SECURE_COOKIES=false
SECURITY_SESSION_COOKIE_NAME=pb_session

# 邮件提醒（默认关闭）。启用时需要 host/port/username/password/from_address。
# 目标服务商：**阿里邮箱**（2026-10-12 实测投递成功）。
#   * SSL 端口 465 + 直接 TLS（MAIL_IMPLICIT_TLS=true、MAIL_USE_TLS=false）；
#     阿里邮箱未开放 587/80，非加密只有 25；
#   * 密码填"三方客户端安全密码"，不是邮箱登录密码；
#   * 认证机制：login（默认）、plain、xoauth2。
# 若某服务商要求 OAuth2（官方文档写 OAuth2/Modern Auth 时），置为 xoauth2
# 并提供外部获取的访问令牌；本服务不实现 OAuth2 授权码流程。
MAIL_ENABLED=false
MAIL_HOST=smtp.qiye.aliyun.com
MAIL_PORT=465
MAIL_IMPLICIT_TLS=true
MAIL_USE_TLS=false
MAIL_AUTH_METHOD=login
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_OAUTH2_ACCESS_TOKEN=
MAIL_TASK_URL_TEMPLATE=http://localhost:8080/tasks/{task_id}

# 全局限流（按来源地址分桶的令牌桶）。默认开启、取值宽松；
# 调小它可以复现 429，置 false 可整体关闭。
RATELIMIT_ENABLED=true
RATELIMIT_REQUESTS_PER_MINUTE=3000
RATELIMIT_BURST=300

# 引导管理员：系统初始化后录入的系统级后台账号。
# 4 项要么整组配置，要么全部留空；只配一部分会导致启动失败。
# 账号已存在时只确保角色、**不覆盖密码**，因此创建完成后应从环境中移除本行。
# SECURITY_BOOTSTRAP_ADMIN_USERNAME=admin
# SECURITY_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# SECURITY_BOOTSTRAP_ADMIN_PASSWORD=
# SECURITY_BOOTSTRAP_ADMIN_DISPLAY_NAME=系统管理员
