# 本地/测试覆盖配置。复制为 .env 使用；进程环境变量优先级最高。
# 本文件只包含字段名与占位符，不得写入真实密码或密钥。

APP_ENV=development
APP_CONFIG_FILE=config.toml

SERVER_HOST=127.0.0.1
SERVER_PORT=8000
SERVER_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=project_builder
DATABASE_USER=project_builder
DATABASE_PASSWORD=change-me
DATABASE_SSL_MODE=disable

REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

MAIL_ENABLED=true
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_USE_TLS=true

SECURITY_SESSION_SECRET=change-me-in-dev
SECURITY_SECURE_COOKIES=false
SECURITY_SESSION_COOKIE_NAME=pb_session
